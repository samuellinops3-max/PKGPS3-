#---------------------------------------------------------------------------------
# Simple Makefile for SlitherPS3
#---------------------------------------------------------------------------------

TARGET		:=	SlitherPS3
BUILD		:=	build
SOURCES		:=	.
INCLUDES	:=	.

TITLE		:=	SlitherPS3 Offline
APPID		:=	SLIT00001
CONTENTID	:=	UP0001-$(APPID)_00-0000000000000000

#---------------------------------------------------------------------------------
ifeq ($(strip $(PSL1GHT)),)
$(error "PSL1GHT not set")
endif

include $(PSL1GHT)/ppu_rules

#---------------------------------------------------------------------------------
CFLAGS		:=	-O2 -Wall -mcpu=cell $(MACHDEP) $(INCLUDE)
CXXFLAGS	:=	$(CFLAGS)
LDFLAGS		:=	\( (MACHDEP) -Wl,-Map, \)(notdir $@).map

LIBS		:=	-lrsx -lgcm_sys -lio -lsysutil -lrt -llv2 -lm

#---------------------------------------------------------------------------------
CFILES		:=	\( (foreach dir, \)(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
OFILES		:=	$(CFILES:.c=.o)

#---------------------------------------------------------------------------------
all: $(TARGET).elf

$(TARGET).elf: $(OFILES)
	$(CC) $^ $(LDFLAGS) $(LIBPATHS) $(LIBS) -o $@
	$(SPRX) $@
	$(MAKESELF) $(TARGET).elf $(TARGET).self

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

pkg: $(TARGET).pkg

$(TARGET).pkg: $(TARGET).self
	$(PKG) --contentid $(CONTENTID) $(TARGET).self $@

clean:
	rm -f *.o $(TARGET).elf $(TARGET).self $(TARGET).pkg

.PHONY: all clean pkg