TARGET		:=	SlitherPS3
TITLE		:=	Slither.io PS3 Native
APPID		:=	SLIT00001
CONTENT_ID	:=	UP0001-SLIT00001_00-0000000000000000

SOURCE		:=	source
OBJS		:=	$(SOURCE)/main.o

LIBS		:=	-lsl1ght -lvsh -lrt -lvf -lsysutil -lmodplay -lpng -lz -lm

include $(PSL1GHT)/ppu_rules

all: $(TARGET).self

$(TARGET).self: $(TARGET).elf
	@echo "Criando arquivo SELF..."
	@make_self $< $@

$(TARGET).elf: $(OBJS)
	@echo "Vinculando executavel ELF..."
	@$(CC) $(OBJS) $(LIBS) -o $@

%.o: %.c
	@echo "Compilando código C: $<"
	@$(CC) -I$(PSL1GHT)/ppu/include -c $< -o $@

clean:
	@rm -rf $(SOURCE)/*.o $(TARGET).elf $(TARGET).self $(TARGET).pkg pkg
