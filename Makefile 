TARGET		:=	SlitherPS3
TITLE		:=	Slither.io PS3 Native
APPID		:=	SLIT00001
CONTENT_ID	:=	UP0001-SLIT00001_00-0000000000000000

SOURCE		:=	source
OBJS		:=	$(SOURCE)/main.o

LIBS		:=	-lsl1ght -lvsh -lrt -lvf -lsysutil -lmodplay -lpng -lz -lm

include $(PSL1GHT)/ppu_rules

all: $(TARGET).self

$(TARGET).self: $(TARGET).elf
	make_self $< $@

$(TARGET).elf: $(OBJS)
	$(CC) $(OBJS) $(LIBS) -o $@

clean:
	rm -rf $(SOURCE)/*.o $(TARGET).elf $(TARGET).self $(TARGET).pkg pkg
